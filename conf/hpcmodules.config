/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

// ref/type: first reference genome
// ref2/type2: second reference genome
// Example 1 - hg19Aligned_virusUnknown: meta: [id: "sample1", rg: $RG, ref: "hg19", type: "Aligned", ref2: "virus", type2: "Unknown", consensus: "none/dcs/dcs.sc/sscs/sscs.sc/all.unique.dcs"]
// Example 2 - hg19Unmapped_HPV_38genomesAligned: meta: [id: "sample1", rg: $RG, ref: "hg19", type: "Unmapped", ref2: "HPV_38genomes", type2: "Aligned", consensus: "none/dcs/dcs.sc/sscs/sscs.sc/all.unique.dcs"]]

process {
/*
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
*/
    withName: 'SRATOOLS_FASTERQDUMP' {
        module = 'sratoolkit/3.3.0'
    }

    withName: FASTQC {
        if (params.skip_fastqc) {
            ext.when = false
        }
        module = 'fastqc/0.12.1'
        ext.args = '--quiet'

        cpus   = { 2     * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 3.h   * task.attempt }
    }

    withName: 'MULTIQC' {
        if (params.skip_multiqc) {
            ext.when = false
        }
        module = 'multiqc/1.32'
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [ path: { "results/multiqc" }, mode: 'copy' ] //, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    }
    withName: FASTP {
        conda = 'bioconda::fastp=0.23.4'
        ext.args = "--max_len1 ${params.max_read_length} --max_len2 ${params.max_read_length} --disable_quality_filtering --disable_adapter_trimming"
    }

    withName: 'TAGTOHEADER' {
        publishDir = [ path: "results/tag_to_header", mode: 'copy' ] 
        cpus = { 2       }
    }
    withName: 'COUNT_READS_RAW' {
        ext.prefix = { "${meta.id}_raw" }
    }
    withName: 'COUNT_READS_GOODUMI' {
        ext.prefix = { "${meta.id}_goodUMI" }
    }
    withName: '.*SAMTOOLS_.*' { 
        module = 'samtools/1.20' 
    }
    withName: '.*SAMTOOLS_SORT' {
        // This resolves the name clash by renaming the output
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}_${meta.consensus}_sorted" } 
    }
    withName: '.*SAMTOOLS_VIEW_UNMAPPED' {
        ext.prefix = { "${meta.id}_${meta.ref}Unmapped" }
        ext.args = { "-f 4 --output-fmt bam"} 
    }
    withName: '.*SAMTOOLS_VIEW_PROPERLYPAIRED' {
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}_${meta.consensus}.f2" }
        ext.args = { "-f 2 --output-fmt bam"} 
    }
    withName: '.*BWA_MEM' { 
        module = ['bwa/0.7.15', 'samtools/1.20']
        ext.args = { "-R ${meta.rg}" } 
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}" } 
    }
    withName: 'HPVSEQ:ALIGN_BWA:BAM_.*STATS_SAMTOOLS:SAMTOOLS_.*' {
        publishDir = [ path: "results/bwa", mode: 'copy' ] 
    }
    withName: 'HPVSEQ:QUANTIFICATION:BAM_.*STATS_SAMTOOLS:SAMTOOLS_.*' {
        publishDir = [ path: "results/bwa_virus", mode: 'copy' ] 
    }
    withName: 'GATK4_BASERECALIBRATOR' {
        //beforeScript = 'export PYTHONPATH=""; export PYTHONHOME=""; export PYTHONNOUSERSITE=1'
        beforeScript = 'unset PYTHONPATH; unset PYTHONHOME; export APPTAINER_CLEANENV=1'
        module = 'gatk/4.6.0.0'
    }
    withName: 'GATK4_APPLYBQSR' {
        //beforeScript = 'unset PYTHONPATH'
        //beforeScript = 'module unload gatk/3.8'
        //beforeScript = 'export PYTHONPATH=""; export PYTHONHOME=""; export PYTHONNOUSERSITE=1'
        beforeScript = 'unset PYTHONPATH; unset PYTHONHOME; export APPTAINER_CLEANENV=1'
        module = 'gatk/4.6.0.0'
        ext.prefix = { "${meta.id}_bqsr" }
        ext.suffix = "bam" 
    }
    withName: 'SORT_BQSR' {
        // This resolves the name clash by renaming the output
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}_${meta.consensus}_bqsr_sorted" }
        //publishDir = [ path: "results/bqsr", mode: 'copy' ] 
    }
/*
    withName: '.*CONSENSUSCRUNCHER.*' {
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'ignore' }
        maxRetries    = 3
    }
*/
    withName: 'GENOTYPING_READS' {
        module = 'samtools/1.20' 
        publishDir = [ path: {"results/report/genotyping/"}, mode: 'copy' ] 
    }
    withName: 'PICARD_COLLECTHSMETRICS' {
        conda = 'bioconda::picard=3.4.0 conda-forge::openjdk=21' 
        publishDir = [ path: {"results/report/hsmetrics/"}, mode: 'copy' ]

        // Clean the environment and point to the Conda Java binary
        beforeScript = """
        unset JAVA_HOME
        unset JAVA_ROOT
        export PATH="/cluster/home/jfzou/miniconda3/envs/nextflow_env/bin:\$PATH"
        echo "LOG: Using Java from \$(which java) - version: \$(java -version 2>&1 | head -n 1)"
        """
    }
    withName: 'DEDUP' {
        conda = 'bioconda::picard=3.4.0 conda-forge::openjdk=21' 
        ext.args = '--REMOVE_DUPLICATES true'

        // Clean the environment and point to the Conda Java binary
        beforeScript = """
        unset JAVA_HOME
        unset JAVA_ROOT
        export PATH="/cluster/home/jfzou/miniconda3/envs/nextflow_env/bin:\$PATH"
        echo "LOG: Using Java from \$(which java) - version: \$(java -version 2>&1 | head -n 1)"
        """
    }
    withName: 'PICARD_COLLECTINSERTSIZEMETRICS' {
        conda = 'bioconda::picard=3.4.0 conda-forge::openjdk=21' 
        publishDir = [ path: {"results/report/insertsize/"}, mode: 'copy' ]
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}_${meta.consensus}_${meta.insertsize}_insertsize_metrics" }
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'ignore' }
        maxRetries    = 2

        // Clean the environment and point to the Conda Java binary
        beforeScript = """
        unset JAVA_HOME
        unset JAVA_ROOT
        export PATH="/cluster/home/jfzou/miniconda3/envs/nextflow_env/bin:\$PATH"
        echo "LOG: Using Java from \$(which java) - version: \$(java -version 2>&1 | head -n 1)"
        """
    }
    withName: 'SMASH' {
        publishDir = [ path: {"results/report/smash/"}, mode: 'copy' ]
        cpus   = { 1                    }
        memory = { 60.GB * task.attempt }
        time   = { 16.h  * task.attempt }
        queue  = {
            if( task.memory > 60.GB )
                return 'veryhimem'
            else if ( task.memory > 30.GB )
                return 'himem'
            else
                return 'all'
        }
    }
    withName: 'COVERAGE_QC_.*' {
        module     = 'gatk/3.8'
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}_${meta.consensus}.qc" }
        publishDir = [ path: {"results/report/coverage/qc"}, mode: 'copy' ]
    }
    withName: /^(COVERAGE_QC_BWA|COVERAGE_QC_ALLUNIQUEDCS)$/ {
        module     = 'gatk/3.8'
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}_${meta.consensus}.qc" }
        publishDir = [ path: {"results/report/coverage/qc"}, mode: 'copy' ]

        cpus   = {
            if( meta.size_gb < 3 )
                return 8 * task.attempt
            else if( meta.size_gb < 10 )
                return 16 * task.attempt
            else
                return 24 * task.attempt
        }
        memory = {
            if( meta.size_gb < 3 )
                return 16.GB * task.attempt
            else if( meta.size_gb < 6 )
                return 30.GB * task.attempt
            else if( meta.size_gb < 10 )
                return 60.GB * task.attempt
            else 
                return 100.GB * task.attempt
        }
        time   = {
            if( meta.size_gb < 3 )
                return 8.h * task.attempt
            else if( meta.size_gb < 6 )
                return 12.h * task.attempt
            else if( meta.size_gb < 10 )
                return 16.h * task.attempt
            else
                return 24.h * task.attempt
        }
        queue  = {
            if( task.memory > 60.GB )
                return 'veryhimem'
            else if ( task.memory > 30.GB )
                return 'himem'
            else
                return 'all'
        }
    }
    withName: 'COVERAGE_QUANTIFICATION_DOMINANT' {
        module = 'gatk/3.8'
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}_${meta.consensus}.quantification_dominant" }
        publishDir = [ path: {"results/report/coverage/quantification_dominant"}, mode: 'copy' ]
    }
    withName: 'COVERAGE_QUANTIFICATION_CORRECTED' {
        module = 'gatk/3.8'
        ext.prefix = { "${meta.id}_${meta.ref}${meta.type}_${meta.ref2}${meta.type2}_${meta.consensus}.quantification_corrected" }
        publishDir = [ path: {"results/report/coverage/quantification_corrected"}, mode: 'copy' ]
    }
    withName: 'INTEGRATION_SEARCHPV' {
        module = ['samtools/1.20', 'bwa/0.7.15', 'jdk/1.8.0', 'gatk/3.8'] 
        ext.args = { "-mem ${task.memory.giga}g -nt ${task.cpus} -gz" }
        publishDir = [ path: {"results/report/integration"}, mode: 'copy' ]
        errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'ignore' }
        maxRetries    = 3

        beforeScript = '''
        export PYTHONPATH=$HOME/.local/lib/python3.7/site-packages:$PYTHONPATH
        '''
    }
    withName: 'CORRECT_GENOTYPE' {
        publishDir = [ path: {"results/summary"}, mode: 'copy' ]
    }
    withName: 'SUMMARIZE_.*' {
        publishDir = [ path: {"results/summary"}, mode: 'copy' ]
    }
}

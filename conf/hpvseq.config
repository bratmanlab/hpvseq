/*
    nf-core/hpvseq Nextflow MiSeq config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // TODO nf-core: Check the defaults for all processes
    cpus   = { 1      * task.attempt }
    memory = { 2.GB   * task.attempt }
    time   = { 1.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 
            if( meta.size_gb < 3 )
                return 2 * task.attempt 
            else if( meta.size_gb < 15 )
                return 4 * task.attempt
            else 
                return 8 * task.attempt
        } 
        memory = { 
            if( meta.size_gb < 3 )
                return 4.GB * task.attempt
            else if( meta.size_gb < 15 )
                return 8.GB * task.attempt
            else 
                return 16.GB * task.attempt 
        }
        time   = { 
            if( meta.size_gb < 3 )
                return 4.h * task.attempt 
            else if( meta.size_gb < 6 )
                return 6.h * task.attempt
            else if( meta.size_gb < 10 )
                return 10.h * task.attempt
            else if( meta.size_gb < 15 )
                return 14.h * task.attempt
            else if( meta.size_gb < 20 )
                return 18.h * task.attempt
            else 
                return 20.h * task.attempt
        }
        queue  = {
            if( task.memory > 60.GB )
                return 'veryhimem'
            else if ( task.memory > 30.GB ) 
                return 'himem'
            else
                return 'all'
        }
    }
    withLabel:process_medium {
        cpus   = { 
            if( meta.size_gb < 3 )
                return 4 * task.attempt 
            else if( meta.size_gb < 6 )
                return 8 * task.attempt
            else if( meta.size_gb < 20 )
                return 16 * task.attempt
            else 
                return 24 * task.attempt
        } 
        memory = { 
            if( meta.size_gb < 3 )
                return 8.GB * task.attempt
            else if( meta.size_gb < 6 )
                return 16.GB * task.attempt
            else if( meta.size_gb < 20 )
                return 30.GB * task.attempt
            else 
                return 48.GB * task.attempt 
        }
        time   = { 
            if( meta.size_gb < 3 )
                return 4.h * task.attempt
            else if( meta.size_gb < 6 )
                return 6.h * task.attempt
            else if( meta.size_gb < 10 )
                return 10.h * task.attempt
            else if( meta.size_gb < 15 )
                return 14.h * task.attempt
            else if( meta.size_gb < 20 )
                return 18.h * task.attempt 
            else 
                return 20.h * task.attempt
        }
        queue  = {
            if( task.memory > 60.GB )
                return 'veryhimem'
            else if ( task.memory > 30.GB ) 
                return 'himem'
            else
                return 'all'
        }
    }
    withLabel:process_high {
        cpus   = { 
            if( meta.size_gb < 3 )
                return 4 * task.attempt 
            else if( meta.size_gb < 10 )
                return 8 * task.attempt
            else if( meta.size_gb < 20 )
                return 16 * task.attempt
            else 
                return 32 * task.attempt
        } 
        memory = { 
            if( meta.size_gb < 3 )
                return 8.GB * task.attempt
            else if( meta.size_gb < 10 )
                return 16.GB * task.attempt
            else if( meta.size_gb < 15 )
                return 24.GB * task.attempt
            else if( meta.size_gb < 20 )
                return 32.GB * task.attempt
            else 
                return 48.GB * task.attempt 
        }
        time   = { 
            if( meta.size_gb < 3 )
                return 6.h * task.attempt 
            else if( meta.size_gb < 6 )
                return 10.h * task.attempt
            else if( meta.size_gb < 10 )
                return 14.h * task.attempt
            else if( meta.size_gb < 15 )
                return 18.h * task.attempt
            else if( meta.size_gb < 20 )
                return 24.h * task.attempt
            else 
                return 28.h * task.attempt
        }
        queue  = {
            if( task.memory > 60.GB )
                return 'veryhimem'
            else if ( task.memory > 30.GB ) 
                return 'himem'
            else
                return 'all'
        }
    }
    withLabel:process_higher {
        cpus   = { 
            if( meta.size_gb < 3 )
                return 8 * task.attempt 
            else if( meta.size_gb < 10 )
                return 16 * task.attempt
            else if( meta.size_gb < 15 )
                return 24 * task.attempt
            else 
                return 32 * task.attempt
        } 
        memory = { 
            if( meta.size_gb < 3 )
                return 16.GB * task.attempt
            else if( meta.size_gb < 6 )
                return 30.GB * task.attempt
            else if( meta.size_gb < 10 )
                return 60.GB * task.attempt
            else if( meta.size_gb < 15 )
                return 100.GB * task.attempt
            else if( meta.size_gb < 20 )
                return 120.GB * task.attempt 
            else 
                return 150.GB * task.attempt 
        }
        time   = { 
            if( meta.size_gb < 3 )
                return 8.h * task.attempt 
            else if( meta.size_gb < 6 )
                return 12.h * task.attempt
            else if( meta.size_gb < 10 )
                return 16.h * task.attempt
            else if( meta.size_gb < 15 )
                return 24.h * task.attempt
            else if( meta.size_gb < 20 )
                return 32.h * task.attempt
            else 
                return 36.h * task.attempt
        }
        queue  = {
            if( task.memory > 60.GB )
                return 'veryhimem'
            else if ( task.memory > 30.GB ) 
                return 'himem'
            else
                return 'all'
        }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}

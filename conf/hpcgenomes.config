// conf/hpcgenomes.config
params {
    // This tells the pipeline to ignore the default S3/iGenomes paths
    igenomes_ignore = true 

    genomes {
        'hg19' {
            fasta       = "${params.ref_path}/hg19/ref/ucsc.hg19.fasta"
            fai         = "${params.ref_path}/hg19/ref/ucsc.hg19.fasta.fai"
            dict        = "${params.ref_path}/hg19/ref/ucsc.hg19.dict"
            bwa_index   = "${params.ref_path}/hg19/bwa/"
            dbsnp       = "${params.ref_path}/hg19/variantcallingdata/dbsnp_138.hg19.vcf"
            dbsnp_tbi   = "${params.ref_path}/hg19/variantcallingdata/dbsnp_138.hg19.vcf.idx"
            indels      =  "${params.ref_path}/hg19/variantcallingdata/Mills_and_1000G_gold_standard.indels.hg19.vcf,${params.ref_path}/hg19/variantcallingdata/1000G_phase1.indels.hg19.vcf"
            indels_tbi  = "${params.ref_path}/hg19/variantcallingdata/Mills_and_1000G_gold_standard.indels.hg19.vcf.idx,${params.ref_path}/hg19/variantcallingdata/1000G_phase1.indels.hg19.vcf.idx"
            // Add only the tools you are actually using
            // bowtie2 = "/cluster/data/igenomes/Homo_sapiens/UCSC/hg19/Sequence/Bowtie2Index/"
        }
        'hg38' {
            fasta       = "/cluster/data/igenomes/Homo_sapiens/UCSC/hg38/Sequence/WholeGenomeFasta/genome.fa"
            bwa_index   = "/cluster/data/igenomes/Homo_sapiens/UCSC/hg38/Sequence/BWAIndex/"
        }
        'HPV_38genomes' {
            fasta       = "${params.ref_path_virus}/HPV_38genomes/HPV_38genomes.fasta"
            fai         = "${params.ref_path_virus}/HPV_38genomes/HPV_38genomes.fasta.fai"
            dict        = "${params.ref_path_virus}/HPV_38genomes/HPV_38genomes.dict"
            bwa_index   = "${params.ref_path_virus}/HPV_38genomes/"
        }
    }
}


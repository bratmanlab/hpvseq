{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/hpvseq/master/assets/schema_input.json",
    "title": "nf-core/hpvseq pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
	    "sample" : { "type": "string", "pattern": "^\\S+$", "meta": ["id"] },
	    "sra_accession": { "type": "string", "format": "directory-path" },
	    "lane"   : { "type": "integer", "minimum": 1 },
	    "fastq_1": { "type": "string", "format": "file-path" },
	    "fastq_2": { "type": "string", "format": "file-path" }
        },
        "anyOf": [
            { "required": ["sample", "sra_accession"] },
            { "required": ["sample", "lane", "fastq_1", "fastq_2"] },
            { "required": ["sample", "lane", "fastq_1"] }
        ]
    }
}
